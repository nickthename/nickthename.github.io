<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smash 64 VOD Search</title>
    <style>
      body { font-family: sans-serif; padding: 1rem; }
      .filters { display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem; }
      .filter-group { display: flex; flex-direction: column; }
      .filter-group label { font-size: 0.9rem; margin-bottom: 0.2rem; }
      table { border-collapse: collapse; width: 100%; }
      th, td { border: 1px solid #ccc; padding: 0.5rem; text-align: left; }
 
      body {
        font-family: sans-serif;
        padding: 1rem;
        line-height: 1.4;
      }

      h1 {
        font-size: 1.8rem;
        margin-bottom: 1rem;
      }

      .filters {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1rem;
      }

      .filter-group {
        display: flex;
        flex-direction: column;
        flex: 1 1 150px;
      }

      .filter-group label {
        font-size: 1rem;
        margin-bottom: 0.3rem;
      }

      .filter-group select,
      .filter-group input[type="text"],
      .filter-group input[type="date"] {
        padding: 0.6rem 0.8rem;
        font-size: 1rem;
        border: 1px solid #bbb;
        border-radius: 0.5rem;
        outline: none;
        transition: border-color 0.2s;
      }

      .filter-group select:focus,
      .filter-group input:focus {
        border-color: #888;
      }

      table {
        border-collapse: collapse;
        width: 100%;
        font-size: 0.95rem;
        overflow-x: auto;
      }

      thead th {
        background-color: #fafafa;
        position: sticky;
        top: 0;
        z-index: 1;
      }

      th,
      td {
        border: 1px solid #ddd;
        padding: 0.6rem;
        text-align: left;
      }

      tbody tr:hover {
        background-color: #f5faff;
      }

      tbody tr:nth-child(even) {
        background-color: #fcfcfc;
      }

      @media (max-width: 600px) {
        .filters {
          flex-direction: column;
        }
        table {
          display: block;
          overflow-x: auto;
        }
        th,
        td {
          white-space: nowrap;
        }
      }
         th { background-color: #f0f0f0; }
    </style>
  </head>
  <body>
    <h1>Smash 64 Vod Search</h1>
    <div class="filters">
      <div class="filter-group">
        <label for="eventFilter">Event:</label>
        <select id="eventFilter">
          <option value="">All</option>
        </select>
      </div>
      <div class="filter-group">
        <label for="char1Filter">Player 1 Character:</label>
        <select id="char1Filter">
          <option value="">All</option>
        </select>
      </div>
      <div class="filter-group">
        <label for="char2Filter">Player 2 Character:</label>
        <select id="char2Filter">
          <option value="">All</option>
        </select>
      </div>
      <div class="filter-group">
        <label for="player1Filter">Player 1:</label>
        <input type="text" id="player1Filter" placeholder="Search player 1">
      </div>
      <div class="filter-group">
        <label for="player2Filter">Player 2:</label>
        <input type="text" id="player2Filter" placeholder="Search player 2">
      </div>
      <div class="filter-group">
        <label for="dateFromFilter">Date From:</label>
        <input type="date" id="dateFromFilter">
      </div>
      <div class="filter-group">
        <label for="dateToFilter">Date To:</label>
        <input type="date" id="dateToFilter">
      </div>
    </div>

    <table id="vodTable">
      <thead>
        <tr>
          <th>Event</th>
          <th>Round</th>
          <th>Player 1</th>
          <th>Character 1</th>
          <th>Player 2</th>
          <th>Character 2</th>
          <th>Date</th>
          <th>VOD</th>
        </tr>
      </thead>
      <tbody>
        <!-- rows will be added here -->
      </tbody>
    </table>

    <script>
      function parseDate(str) {
        const [m, d, y] = str.split('-').map(n => parseInt(n, 10));
        return new Date(y, m - 1, d);
      }
      async function loadCSV() {
        const resp = await fetch('vods.csv');
        const text = await resp.text();
        const lines = text.trim().split('\n').filter(line => line.trim());
        return lines.map(line => {
          const cols = line.split(',').map(s => s.trim());
        const [event, round, p1, c1_raw, p2, c2_raw, date, url] = cols;
        const c1 = c1_raw.split(';').map(s => s.trim()).filter(Boolean);
        const c2 = c2_raw.split(';').map(s => s.trim()).filter(Boolean);
        return { event, round, p1, c1, p2, c2, date, dateObj: parseDate(date), url };
        });
      }

      function populateFilters(data) {
        const events = new Set();
        const chars = new Set();
        data.forEach(d => {
          events.add(d.event);
          d.c1.forEach(c => chars.add(c));
          d.c2.forEach(c => chars.add(c));
        });
        const eventFilter = document.getElementById('eventFilter');
        const char1Filter = document.getElementById('char1Filter');
        const char2Filter = document.getElementById('char2Filter');
        [...events].sort().forEach(e => {
          const opt = document.createElement('option');
          opt.value = e;
          opt.textContent = e;
          eventFilter.appendChild(opt);
        });
        [...chars].sort().forEach(c => {
          const opt1 = document.createElement('option');
          opt1.value = c;
          opt1.textContent = c;
          char1Filter.appendChild(opt1);
          const opt2 = document.createElement('option');
          opt2.value = c;
          opt2.textContent = c;
          char2Filter.appendChild(opt2);
        });
      }

      function renderTable(data) {
        data.sort((a, b) => b.dateObj - a.dateObj);
        const tbody = document.querySelector('#vodTable tbody');
        tbody.innerHTML = '';
        data.forEach(d => {
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td>${d.event}</td>
            <td>${d.round}</td>
            <td>${d.p1}</td>
            <td>${d.c1}</td>
            <td>${d.p2}</td>
            <td>${d.c2}</td>
            <td>${d.date}</td>
            <td><a href="https://www.youtube.com/watch?v=${d.url}" target="_blank">Watch</a></td>
          `;
          tbody.appendChild(tr);
        });
      }

      function applyFilters(data) {
        const eventVal = document.getElementById('eventFilter').value;
        const char1Val = document.getElementById('char1Filter').value;
        const char2Val = document.getElementById('char2Filter').value;
        const player1Val = document.getElementById('player1Filter').value.toLowerCase();
        const player2Val = document.getElementById('player2Filter').value.toLowerCase();
        const dateFromVal = document.getElementById('dateFromFilter').value;
        const dateToVal = document.getElementById('dateToFilter').value;
        const dateFrom = dateFromVal ? new Date(dateFromVal) : null;
        const dateTo = dateToVal ? new Date(dateToVal) : null;
        const filtered = data.filter(d => {
          let charMatch;
          if (char1Val && char2Val && char1Val === char2Val) {
            charMatch = d.c1.includes(char1Val) && d.c2.includes(char2Val);
          } else {
            const char1Match = !char1Val || d.c1.includes(char1Val) || d.c2.includes(char1Val);
            const char2Match = !char2Val || d.c1.includes(char2Val) || d.c2.includes(char2Val);
            charMatch = char1Match && char2Match;
          }
          const player1Match = !player1Val || d.p1.toLowerCase().includes(player1Val) || d.p2.toLowerCase().includes(player1Val);
          const player2Match = !player2Val || d.p1.toLowerCase().includes(player2Val) || d.p2.toLowerCase().includes(player2Val);
          const dateMatch = (!dateFrom || d.dateObj >= dateFrom) && (!dateTo || d.dateObj <= dateTo);
          return (!eventVal || d.event === eventVal) && charMatch && player1Match && player2Match && dateMatch;
        });
        renderTable(filtered);
      }

      document.addEventListener('DOMContentLoaded', async () => {
        const data = await loadCSV();
        populateFilters(data);
        renderTable(data);
        document.getElementById('eventFilter').addEventListener('change', () => applyFilters(data));
        document.getElementById('char1Filter').addEventListener('change', () => applyFilters(data));
        document.getElementById('char2Filter').addEventListener('change', () => applyFilters(data));
        document.getElementById('player1Filter').addEventListener('input', () => applyFilters(data));
        document.getElementById('player2Filter').addEventListener('input', () => applyFilters(data));
        document.getElementById('dateFromFilter').addEventListener('change', () => applyFilters(data));
        document.getElementById('dateToFilter').addEventListener('change', () => applyFilters(data));
      });
    </script>
  </body>
</html>
